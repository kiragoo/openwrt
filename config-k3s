CONFIG_BUSYBOX_DEFAULT_LSPCI=y

# System Certificates
CONFIG_PACKAGE_ca-certificates=y

# Container Runtime
CONFIG_PACKAGE_containerd=y

# Storage Configuration
# Root filesystem partition size (in MiB)
# Set to 1024MB (1GB) - sufficient for containerd and packages
# Current rootfs content: ~182MB, leaving ~800MB for runtime data and growth
# Note: Too large values (e.g., 4096MB) cause "No space left on device" during build
#       as build process needs to create temporary files of this size
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# Disable unnecessary packages
# CONFIG_PACKAGE_kmod-ppp is not set
# CONFIG_PACKAGE_ppp is not set
